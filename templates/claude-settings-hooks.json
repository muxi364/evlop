{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "EVLOP automatic self-evolution lifecycle hooks for Claude Code (.claude/settings.json)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m evlop status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m evlop evolve --target AGENTS.md,CLAUDE.md"
          }
        ]
      }
    ]
  }
}
